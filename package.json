{
  "name": "playground-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-pglite.mjs && npm run content",
    "dev": "next dev",
    "dev:dis": "CONTENT_DIR=examples/dis npm run dev",
    "prebuild": "node scripts/copy-pglite.mjs && npm run content",
    "build": "next build",
    "build:dis": "CONTENT_DIR=examples/dis npm run build",
    "postbuild": "node scripts/write-precache-manifest.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "schema": "tsx scripts/content/schema-export.ts",
    "validate": "tsx scripts/content/validate.ts",
    "content": "tsx scripts/content/build.ts",
    "dev:showcase": "CONTENT_DIR=examples/showcase npm run dev",
    "build:showcase": "CONTENT_DIR=examples/showcase npm run build",
    "docs:reference": "tsx scripts/docs/reference.ts",
    "generate": "tsx scripts/generate/cli.ts",
    "import": "tsx scripts/content/import.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-pgvector": "^0.0.16",
    "@google/genai": "^2.24.0",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "katex": "^0.18.7",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "pdfjs-dist": "^5.7.284",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "license": "MIT"
}
