{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string"
    },
    "shortTitle": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
    },
    "indexable": {
      "type": "boolean"
    },
    "overviewBadge": {
      "type": "string"
    },
    "overviewTitle": {
      "type": "string"
    },
    "overviewMd": {
      "type": "string"
    },
    "footerText": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": [
        "school",
        "university",
        "professional"
      ]
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "core",
          "math",
          "cs",
          "memorise",
          "humanities"
        ]
      }
    },
    "examDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "theme": {
      "type": "object",
      "properties": {
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "corners": {
          "type": "string",
          "enum": [
            "soft",
            "sharp"
          ]
        }
      },
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "properties": {
        "assistant": {
          "type": "boolean"
        },
        "difficult": {
          "type": "boolean"
        },
        "search": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "title",
    "shortTitle",
    "description",
    "language",
    "indexable"
  ],
  "additionalProperties": false
}
