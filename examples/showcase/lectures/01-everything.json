  "concepts": [
    {
      "id": "kinetic",
      "term": "Kinetic energy",
      "short": "Energy an object has because it moves.",
      "detail": "Grows with the square of the speed."
    },
    {
      "id": "potential",
      "term": "Potential energy",
      "short": "Energy stored by position, for example height.",
      "tags": [
        "gravity"
      ]
    },
    {
      "id": "conservation",
      "term": "Conservation of energy",
      "short": "Energy changes form but the total stays the same in a closed system."
    }
  ],
  "quiz": [
    {
      "id": "q1",
      "prompt": "If the speed doubles, kinetic energy…",
      "options": [
        {
          "id": "a",
          "text": "doubles"
        },
        {
          "id": "b",
          "text": "quadruples"
        },
        {
          "id": "c",
          "text": "stays the same"
        }
      ],
      "answerId": "b",
      "explanation": "E = ½mv², so 2² = 4."
    },
    {
      "id": "q2",
      "prompt": "Which energy does a book on a high shelf have most of?",
      "options": [
        {
          "id": "a",
          "text": "Kinetic"
        },
        {
          "id": "b",
          "text": "Potential"
        }
      ],
      "answerId": "b",
      "explanation": "It is at rest but raised: potential energy."
    },
    {
      "id": "q3",
      "prompt": "In a closed system, total energy…",
      "options": [
        {
          "id": "a",
          "text": "increases"
        },
        {
          "id": "b",
          "text": "decreases"
        },
        {
          "id": "c",
          "text": "stays constant"
        }
      ],
      "answerId": "c",
      "explanation": "That is conservation of energy."
    },
    {
      "id": "q4",
      "prompt": "What is the SI unit of energy?",
      "options": [
        {
          "id": "a",
          "text": "Watt"
        },
        {
          "id": "b",
          "text": "Joule"
        },
        {
          "id": "c",
          "text": "Newton"
        }
      ],
      "answerId": "b",
      "explanation": "One joule is one newton-metre."
    }
  ],
