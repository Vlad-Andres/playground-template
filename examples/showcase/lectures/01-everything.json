          "kind": "practice",
          "id": "practice-energy",
          "tasks": [
            {
              "id": "p1",
              "prompt": "A 2 kg ball moves at 3 m/s. What is its kinetic energy in joules?",
              "check": {
                "mode": "text",
                "accept": [
                  "9",
                  "9 J",
                  "9J"
                ]
              },
              "solution": "½ · 2 · 3² = 9 J.",
              "hint": "Square the speed first."
            },
            {
              "id": "p2",
              "prompt": "Which change gives more kinetic energy?",
              "check": {
                "mode": "select",
                "options": [
                  "Double the mass",
                  "Double the speed"
                ],
                "answer": [
                  "Double the speed"
                ]
              },
              "solution": "Speed is squared, mass is not."
            },
            {
              "id": "p3",
              "prompt": "Describe the energy changes of a swinging pendulum.",
              "check": {
                "mode": "open"
              },
              "solution": "Potential at the top, kinetic at the bottom, and back."
            }
          ],
          "source": [
            {
              "file": "energy-notes.pdf",
              "page": 14
            }
          ]
        },
