      "kind": "mistakes",
      "blocks": [
        {
          "kind": "info",
          "variant": "pitfall",
          "title": "Forgetting to square the speed",
          "md": "Kinetic energy depends on **v²**, not v. Twice as fast means four times the energy.",
          "source": [
            {
              "file": "energy-notes.pdf",
              "page": 12
            }
          ]
        },
        {
          "kind": "info",
          "variant": "warning",
          "title": "Mixing units",
          "md": "Use kg and m/s to get joules. km/h must be divided by 3.6 first.",
          "source": [
            {
              "file": "energy-notes.pdf",
              "page": 12
            }
          ]
        }
